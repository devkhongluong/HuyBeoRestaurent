@model List<webHuyBeo.Models.MonAn>
@{
    ViewData["Title"] = "Quản lý Món ăn";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var danhMucs = ViewBag.DanhMucs as List<webHuyBeo.Models.DanhMuc>;
}

<!-- Header Actions -->
<div class="card-header" style="background:var(--card-bg); border-radius:var(--radius); border:1px solid var(--border); margin-bottom:20px; box-shadow:var(--shadow);">
    <div class="search-bar">
        <form method="get" action="/Admin/MonAn" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <div class="search-input-wrap">
                <i class="fas fa-search"></i>
                <input type="text" name="search" class="search-input" placeholder="Tìm kiếm món ăn..." value="@ViewBag.Search" />
            </div>
            <select name="danhMucId" class="form-select" style="width:auto;">
                <option value="">Tất cả danh mục</option>
                @foreach (var dm in danhMucs ?? new List<webHuyBeo.Models.DanhMuc>())
                {
                    if (ViewBag.DanhMucId?.ToString() == dm.DanhMucID.ToString())
                    {
                        <option value="@dm.DanhMucID" selected>@dm.TenDanhMuc</option>
                    }
                    else
                    {
                        <option value="@dm.DanhMucID">@dm.TenDanhMuc</option>
                    }
                }
            </select>
            <button type="submit" class="btn btn-outline btn-sm"><i class="fas fa-filter"></i> Lọc</button>
        </form>
    </div>
    <a href="/Admin/TaoMonAn" class="btn btn-primary" id="btn-them-mon">
        <i class="fas fa-plus"></i> Thêm món mới
    </a>
</div>

<!-- Table -->
<div class="card">
    <div class="table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Hình ảnh</th>
                    <th>Tên món</th>
                    <th>Danh mục</th>
                    <th>Giá bán</th>
                    <th>Giá vốn</th>
                    <th>Trạng thái</th>
                    <th style="text-align:right">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <i class="fas fa-bowl-food"></i>
                                <p>Chưa có món ăn nào. <a href="/Admin/TaoMonAn" style="color:var(--primary)">Thêm món đầu tiên →</a></p>
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var mon in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(mon.HinhAnh))
                            {
                                <img src="@mon.HinhAnh" class="food-img" alt="@mon.TenMon" />
                            }
                            else
                            {
                                <div class="food-img-placeholder">🍽️</div>
                            }
                        </td>
                        <td>
                            <div style="font-weight:600">@mon.TenMon</div>
                            @if (!string.IsNullOrEmpty(mon.MoTa))
                            {
                                <div style="font-size:12px;color:var(--text-muted);margin-top:2px;">@(mon.MoTa.Length > 50 ? mon.MoTa.Substring(0, 50) + "..." : mon.MoTa)</div>
                            }
                        </td>
                        <td><span class="badge badge-info">@mon.DanhMuc?.TenDanhMuc</span></td>
                        <td style="font-weight:600;color:var(--primary)">@string.Format("{0:N0}đ", mon.GiaBan)</td>
                        <td style="color:var(--text-muted)">@(mon.GiaVon.HasValue ? string.Format("{0:N0}đ", mon.GiaVon) : "-")</td>
                        <td>
                            <label class="toggle" title="@(mon.ConBan ? "Đang bán" : "Hết hàng")">
                                <input type="checkbox" @(mon.ConBan ? "checked" : "")
                                       onchange="toggleMonAn(@mon.MonAnID, this)"
                                       id="toggle-@mon.MonAnID" />
                                <span class="toggle-slider"></span>
                            </label>
                        </td>
                        <td style="text-align:right">
                            <div style="display:flex;gap:6px;justify-content:flex-end;">
                                <a href="/Admin/SuaMonAn/@mon.MonAnID" class="btn btn-outline btn-sm btn-icon" title="Chỉnh sửa">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <button class="btn btn-danger btn-sm btn-icon" title="Xóa"
                                        onclick="confirmXoa(@mon.MonAnID, '@mon.TenMon.Replace("'", "\\'")')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Any())
    {
        <div style="padding:12px 24px;border-top:1px solid var(--border);color:var(--text-muted);font-size:13px;">
            Hiển thị @Model.Count món ăn
        </div>
    }
</div>

<!-- Delete Confirm Modal -->
<div class="modal-overlay" id="xoaModal">
    <div class="modal" style="max-width:420px">
        <div class="modal-header">
            <span class="modal-title" style="color:var(--danger)"><i class="fas fa-triangle-exclamation"></i> Xác nhận xóa</span>
            <button class="modal-close" onclick="closeModal('xoaModal')"><i class="fas fa-times"></i></button>
        </div>
        <div class="modal-body">
            <p>Bạn có chắc chắn muốn xóa món <strong id="xoaTenMon"></strong>?</p>
            <p style="color:var(--text-muted);font-size:13px;margin-top:8px;">Hành động này không thể hoàn tác.</p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('xoaModal')">Hủy</button>
            <form method="post" id="xoaForm" style="margin:0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Xóa</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleMonAn(id, checkbox) {
        fetch('/Admin/ToggleMonAn/' + id, { method: 'POST', headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() } })
            .then(r => r.json())
            .then(data => {
                if (!data.success) checkbox.checked = !checkbox.checked;
            });
    }

    function confirmXoa(id, tenMon) {
        document.getElementById('xoaTenMon').textContent = tenMon;
        document.getElementById('xoaForm').action = '/Admin/XoaMonAn/' + id;
        document.getElementById('xoaModal').classList.add('open');
    }

    function closeModal(id) {
        document.getElementById(id).classList.remove('open');
    }

    // Close modal on backdrop click
    document.querySelectorAll('.modal-overlay').forEach(overlay => {
        overlay.addEventListener('click', function(e) {
            if (e.target === this) this.classList.remove('open');
        });
    });
</script>
}

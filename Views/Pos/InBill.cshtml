@model webHuyBeo.Models.DonHang
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Hóa đơn #@Model.SoThuTu</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Courier New', monospace;
            width: 280px;
            margin: 0 auto;
            padding: 16px;
            font-size: 12px;
            color: #000;
        }
        .bill-header { text-align: center; margin-bottom: 12px; }
        .bill-header h1 { font-size: 18px; font-weight: 700; }
        .bill-header p { font-size: 11px; color: #555; }
        .bill-divider {
            border: none;
            border-top: 1px dashed #999;
            margin: 8px 0;
        }
        .bill-info { margin-bottom: 8px; }
        .bill-info div { display: flex; justify-content: space-between; margin-bottom: 2px; }
        .bill-items .item-row {
            display: flex;
            justify-content: space-between;
            padding: 3px 0;
        }
        .item-name { flex: 1; }
        .item-qty { width: 30px; text-align: center; }
        .item-price { width: 70px; text-align: right; }
        .bill-totals { margin-top: 8px; }
        .bill-totals div { display: flex; justify-content: space-between; padding: 2px 0; }
        .bill-totals .grand-total { font-size: 16px; font-weight: 700; border-top: 2px solid #000; padding-top: 6px; margin-top: 4px; }
        .bill-footer { text-align: center; margin-top: 16px; font-size: 11px; color: #555; }
        @@media print {
            body { width: 100%; }
            .no-print { display: none; }
        }
        .print-btn {
            display: block;
            width: 100%;
            padding: 10px;
            background: #e8590c;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 16px;
        }
    </style>
</head>
<body>
    <div class="bill-header">
        <h1>🍖 HUY BÉO</h1>
        <p>Nhà hàng ẩm thực</p>
    </div>

    <hr class="bill-divider" />

    <div class="bill-info">
        <div><span>Đơn #</span><span>@Model.SoThuTu</span></div>
        <div><span>Ngày</span><span>@Model.NgayTao.ToString("HH:mm dd/MM/yyyy")</span></div>
        <div><span>Loại</span><span>@(Model.LoaiDon == "MangDi" ? "Mang đi" : "Tại chỗ")</span></div>
        @if (Model.PhuongThucTT != null)
        {
            <div><span>Thanh toán</span><span>@(Model.PhuongThucTT == "TienMat" ? "Tiền mặt" : "Chuyển khoản")</span></div>
        }
    </div>

    <hr class="bill-divider" />

    <div class="bill-items">
        <div class="item-row" style="font-weight:700;">
            <span class="item-name">Tên món</span>
            <span class="item-qty">SL</span>
            <span class="item-price">Giá</span>
        </div>
        <hr class="bill-divider" />
        @foreach (var ct in Model.ChiTietDons)
        {
            <div class="item-row">
                <span class="item-name">@ct.MonAn.TenMon</span>
                <span class="item-qty">@ct.SoLuong</span>
                <span class="item-price">@ct.ThanhTien.ToString("N0")</span>
            </div>
        }
    </div>

    <hr class="bill-divider" />

    <div class="bill-totals">
        <div><span>Tổng cộng:</span><span>@Model.TongTien.ToString("N0")đ</span></div>
        @if (Model.TongGiamGia.HasValue && Model.TongGiamGia > 0)
        {
            <div style="color: #e8590c;"><span>Giảm giá:</span><span>-@Model.TongGiamGia.Value.ToString("N0")đ</span></div>
        }
        <div class="grand-total">
            <span>THÀNH TIỀN:</span>
            <span>@Model.ThanhTien.ToString("N0")đ</span>
        </div>
    </div>

    <div class="bill-footer">
        <p>Cảm ơn quý khách!</p>
        <p>Hẹn gặp lại 🍖</p>
    </div>

    <button class="print-btn no-print" onclick="window.print()">
        <i class="fas fa-print"></i> In hóa đơn
    </button>
</body>
</html>
